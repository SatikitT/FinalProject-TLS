~uxn-extension-device.tal
~networking-devices.tal

%LOCALHOST { #7f00 #0001 } ( 127.0.0.01 IPv4 address, 4 bytes )
%INADDR_ANY { #0000 #0000 } ( IPv4 address, 4 bytes )
%MYPORT { #0da2 } ( 3490 )

%NOINFO { POP2 JMP2r }

|0100
@main
  use-network
( /**** open the server TCP socket */ )
 ;dict/socket str/<print>
  SOCK_STREAM socket DUP #ff EQU ?&error ( sfd )
( #30 ADD #18 DEO #0a18 DEO BRK )
  
( /**** set the Reuse-Socket-Address option */   )
  ;dict/setsockopt str/<print>
  DUP DUP ( sfd sfd ) SO_REUSEADDR #01 setsockopt #ff EQU ?&error ( sfd )
  
  ( Set address and port )
 LOCALHOST MYPORT ;hostaddr create_in_addr
( /**** build server socket address */         )
  ;dict/bind str/<print>
  DUP ;hostaddr bind ?&error ( sfd )
  
( /**** create queue 1 only for client connection requests */ )
  ;dict/listen str/<print>
  DUP listen ?&error ( sfd )
   
( /*
 * accept connection and read data until EOF, copying to standard output
 */ )
  ;dict/accept str/<print>
  DUP ( sfd sfd ) ;peeraddr accept DUP #ff EQU ?&error ( sfd cfd )
    ( cfd is returned, the address and port are stored in peeraddr )
    &while
    DUP ( cfd ) ;buf #0400 #00 recv ( sfd cfd len ) 
    DUP2 #0000 GTH2 ?&cont 
    POP2
    !&done  
    &cont ( sfd cfd len )
    ;buf 
    DUP2  ( sfd cfd len ;buf ;buf )
    ROT2 ( sfd cfd  ;buf ;buf len )
    ADD2 ( sfd cfd  ;buf buf[n] )
    #00 ROT ROT STA ( sfd cfd  buf[n] = 0; buf )
   ( Thank you Devine )
    &whilebuf                  ( Create while label )
    LDAk DUP ?{         ( Load byte at address, jump if not null )
        POP POP2 BRK }  ( When null, pop text pointer, halt )
    #18 DEO             ( Send byte to Console/write port )
    INC2 !&whilebuf         ( Incr text pointer, jump to label )

    !&while
    &done ( sfd cfd )

  ( while ((n = recv(cfd, buf, sizeof(buf), 0)) > 0) {
    buf[n] = '\0';
    fputs(buf, stdout); 
  } )
  close
  close
BRK
&error
;dict/error str/<print>
BRK

~networking.tal
( ** Example address and buffer storage, in the user program ** )
( Referenced below using addr_ptr and buf_ptr )
|1000
@hostaddr &ipv4_addr $4 &port $2 
@peeraddr &ipv4_addr $4 &port $2 
@buf $400  ( 1 kB max, ad hoc )

@str/<print> ( str* -- )
  NOINFO
	LDAk DUP ?{ POP POP2 JMP2r }
	#18 DEO
	INC2 !/<print>

@dict
	&socket "socket() 0a $1
	&setsockopt "setsockopt() 0a $1
	&bind "bind() 0a $1
  &listen "listen() 0a $1
  &accept "accept() 0a $1
  &error "Error  0a $1

